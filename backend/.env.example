APP_NAME="Navkwa Build"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_VERSION=
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NAVKWA_BUILD_SEED_DEVELOPMENT=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=navkwabuild
DB_USERNAME=navkwabuild
DB_PASSWORD=navkwabuild_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

BACKUP_DISK=local
BACKUP_PATH=navkwabuild-backups
BACKUP_DAILY_AT=02:00

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@navkwabuild.local"
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=4
SECURITY_LOCKOUT_MINUTES=30
SECURITY_MFA_CHALLENGE_MINUTES=5
SECURITY_REQUIRE_MFA_FOR_PLATFORM_ADMINS=false
SECURITY_REVOKE_OTHER_WEB_TOKENS_ON_LOGIN=true
SECURITY_WEB_TOKEN_LIFETIME_MINUTES=240
SECURITY_API_RATE_LIMIT_PER_MINUTE=120
SECURITY_LOGIN_RATE_LIMIT_PER_MINUTE=5
SECURITY_LOGIN_IP_RATE_LIMIT_PER_MINUTE=20
SECURITY_LOGIN_EMAIL_RATE_LIMIT_PER_MINUTE=10
SECURITY_MFA_RATE_LIMIT_PER_MINUTE=5
SECURITY_MFA_IP_RATE_LIMIT_PER_MINUTE=15
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_SECURITY_POLICY="default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
