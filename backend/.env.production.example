APP_NAME="Navkwa Build"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.navkwabuild.com
APP_VERSION=
FRONTEND_URL=https://app.navkwabuild.com
CORS_ALLOWED_ORIGINS=https://app.navkwabuild.com
SANCTUM_STATEFUL_DOMAINS=
NAVKWA_BUILD_SEED_DEVELOPMENT=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=navkwabuild
DB_USERNAME=navkwabuild_app
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

BACKUP_DISK=local
BACKUP_PATH=navkwabuild-backups
BACKUP_DAILY_AT=02:00

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=no-reply@navkwabuild.com
MAIL_FROM_NAME="${APP_NAME}"

SECURITY_MAX_FAILED_LOGIN_ATTEMPTS=4
SECURITY_LOCKOUT_MINUTES=30
SECURITY_MFA_CHALLENGE_MINUTES=5
SECURITY_REQUIRE_MFA_FOR_PLATFORM_ADMINS=true
SECURITY_REVOKE_OTHER_WEB_TOKENS_ON_LOGIN=true
SECURITY_WEB_TOKEN_LIFETIME_MINUTES=240
SECURITY_API_RATE_LIMIT_PER_MINUTE=120
SECURITY_LOGIN_RATE_LIMIT_PER_MINUTE=5
SECURITY_LOGIN_IP_RATE_LIMIT_PER_MINUTE=20
SECURITY_LOGIN_EMAIL_RATE_LIMIT_PER_MINUTE=10
SECURITY_MFA_RATE_LIMIT_PER_MINUTE=5
SECURITY_MFA_IP_RATE_LIMIT_PER_MINUTE=15
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_SECURITY_POLICY="default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
